<resources>
    <style name="Theme.HermesAgentApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.HermesAgentApp.Splash" parent="Theme.SplashScreen">
